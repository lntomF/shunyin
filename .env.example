# Supabase public client configuration.
# Use your project's public URL and anon/publishable key.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_STORAGE_BUCKET="workspace-images"

# Server-only OpenAI image generation settings.
# Optional fallback values. The web page saves API Key and model locally in the browser.
# Do not prefix these values with VITE_ unless you intentionally want to expose them to the browser.
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_IMAGE_MODEL="gpt-image-1.5"
